---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Acceso Administrativo | ADIEL Distrito 7">
	<meta slot="head" name="robots" content="noindex, nofollow" />

	<main class="max-w-7xl mx-auto px-4 py-12 space-y-8">
		<!-- Pantalla de Bloqueo con Clave Maestra -->
		<section id="login-box" class="max-w-md mx-auto mt-16 bg-slate-900/90 border border-slate-800 rounded-3xl p-8 shadow-2xl space-y-6">
			<div class="text-center space-y-2">
				<span class="px-3 py-1 rounded-lg bg-sky-600 font-black text-xs tracking-wider text-white">ADIEL • DISTRITO 7</span>
				<h1 class="text-xl font-bold text-white pt-2">Panel de Coordinación PEP</h1>
				<p class="text-xs text-slate-400">Ingresa la clave para consultar, certificar y descargar el listado oficial de inscritos.</p>
			</div>

			<form id="authForm" class="space-y-4">
				<div>
					<label for="clave_maestra" class="block text-xs font-semibold uppercase text-slate-300 mb-1.5">Clave</label>
					<input
						type="password"
						id="clave_maestra"
						required
						placeholder="••••••••••••"
						class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white focus:outline-none focus:border-sky-500 transition"
					/>
				</div>

				<div id="auth-error" class="hidden text-xs text-red-400 bg-red-950/50 p-3 rounded-xl border border-red-800"></div>

				<button type="submit" id="btn-acceder" class="w-full py-3.5 rounded-xl font-bold text-white bg-sky-600 hover:bg-sky-500 transition shadow-lg shadow-sky-600/20">
					Ingresar
				</button>
			</form>

			<div class="pt-2 border-t border-slate-800/80 text-center">
				<a href="/" class="inline-flex items-center justify-center gap-1.5 w-full py-2.5 px-4 rounded-xl bg-slate-950/70 hover:bg-slate-800 text-xs font-semibold text-slate-300 hover:text-white border border-slate-800 transition">
					← Volver al inicio
				</a>
			</div>
		</section>

		<!-- Panel Desbloqueado -->
		<section id="panel-box" class="hidden space-y-6">
			<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-slate-900/80 border border-slate-800 p-6 rounded-3xl">
				<div>
					<span class="text-xs font-bold uppercase tracking-wider text-sky-400">ADIEL • Distrito 7</span>
					<h2 class="text-2xl font-extrabold text-white">Inscritos — Taller PEP: Libro de Jonás</h2>
					<p class="text-xs text-slate-400 mt-0.5">Viernes 20 y Sábado 21 de Noviembre • El Trigal, Valencia</p>
				</div>

				<div class="flex flex-wrap gap-3">
					<a href="/" class="px-4 py-3 rounded-xl bg-slate-950/80 hover:bg-slate-800 text-slate-300 border border-slate-800 text-xs font-semibold transition flex items-center">
						← Inicio
					</a>
					<button type="button" id="btn-descargar-pdf" class="px-5 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs sm:text-sm transition shadow-lg shadow-emerald-600/25 flex items-center gap-2">
						📄 Descargar Listado en PDF
					</button>
					<button type="button" id="btn-cerrar-sesion" class="px-4 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold transition">
						Bloquear
					</button>
				</div>
			</div>

			<!-- Tarjetas de Métricas -->
			<div class="grid grid-cols-2 md:grid-cols-5 gap-4">
				<div class="p-4 rounded-2xl bg-slate-900/70 border border-slate-800">
					<span class="text-xs text-slate-400">Total Inscritos</span>
					<strong id="stat-total" class="block text-2xl font-extrabold text-white mt-1">0</strong>
				</div>
				<div class="p-4 rounded-2xl bg-slate-900/70 border border-slate-800">
					<span class="text-xs text-slate-400">Certificados</span>
					<strong id="stat-certificados" class="block text-2xl font-extrabold text-emerald-400 mt-1">0</strong>
				</div>
				<div class="p-4 rounded-2xl bg-slate-900/70 border border-slate-800">
					<span class="text-xs text-slate-400">Plan $20 (Almuerzo)</span>
					<strong id="stat-plan20" class="block text-2xl font-extrabold text-sky-400 mt-1">0</strong>
				</div>
				<div class="p-4 rounded-2xl bg-slate-900/70 border border-slate-800">
					<span class="text-xs text-slate-400">Plan $12 (Material/Café)</span>
					<strong id="stat-plan12" class="block text-2xl font-extrabold text-indigo-400 mt-1">0</strong>
				</div>
				<div class="p-4 rounded-2xl bg-slate-900/70 border border-slate-800 col-span-2 md:col-span-1">
					<span class="text-xs text-slate-400">Solventes / Pendientes</span>
					<div class="mt-1 flex items-baseline gap-2">
						<strong id="stat-pagados" class="text-2xl font-extrabold text-emerald-400">0</strong>
						<span class="text-xs text-slate-400">/</span>
						<strong id="stat-pendientes" class="text-lg font-bold text-amber-400">0</strong>
					</div>
				</div>
			</div>

			<!-- Vista Previa en Tabla -->
			<div class="bg-slate-900/80 border border-slate-800 rounded-3xl overflow-hidden">
				<div class="overflow-x-auto">
					<table class="w-full text-left border-collapse text-xs">
						<thead>
							<tr class="bg-slate-950/90 text-slate-400 uppercase border-b border-slate-800">
								<th class="py-3.5 px-4">#</th>
								<th class="py-3.5 px-4">Código</th>
								<th class="py-3.5 px-4">Participante</th>
								<th class="py-3.5 px-4">Iglesia</th>
								<th class="py-3.5 px-4">Área</th>
								<th class="py-3.5 px-4">Teléfono</th>
								<th class="py-3.5 px-4">Plan</th>
								<th class="py-3.5 px-4">Estatus / Detalle de Pago</th>
								<th class="py-3.5 px-4 text-center">Acción</th>
							</tr>
						</thead>
						<tbody id="tabla-inscritos" class="divide-y divide-slate-800/70 text-slate-200">
						</tbody>
					</table>
				</div>
			</div>
		</section>
	</main>

	<!-- Modal de Certificación y Edición de Datos -->
	<div id="modal-certificar" class="hidden fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4">
		<div class="bg-slate-900 border border-slate-800 rounded-3xl max-w-md w-full p-6 sm:p-7 shadow-2xl space-y-5">
			<div class="border-b border-slate-800 pb-4">
				<span id="modal-badge" class="text-[11px] font-bold uppercase tracking-wider text-emerald-400">Verificación de Pago</span>
				<h3 id="modal-titulo" class="text-lg font-bold text-white mt-0.5">Certificar Participante</h3>
				<p id="modal-participante-info" class="text-xs text-slate-400 mt-1"></p>
			</div>

			<!-- Aviso dinámico sobre los datos registrados por el participante -->
			<div id="modal-aviso-datos" class="p-3 rounded-xl text-xs border"></div>

			<form id="formCertificar" class="space-y-4">
				<input type="hidden" id="cert-id" />

				<div>
					<label for="cert-monto" class="block text-xs font-semibold text-slate-300 mb-1">
						Monto Pagado en Bs. <span class="text-slate-500 font-normal">(Opcional / Editable)</span>
					</label>

					<input
						type="text"
						inputmode="decimal"
						id="cert-monto"
						placeholder="Ej. 1.250,00 (dejar vacío si no aplica)"
						class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500 transition"
					/>
				</div>

				<div>
					<label for="cert-referencia" class="block text-xs font-semibold text-slate-300 mb-1">
						Número de Referencia <span class="text-slate-500 font-normal">(Opcional / Editable)</span>
					</label>
					<input
						type="text"
						id="cert-referencia"
						placeholder="Ej. 482910 (dejar vacío si no aplica)"
						class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500 transition"
					/>
				</div>

				<div id="modal-error" class="hidden text-xs text-red-400 bg-red-950/50 p-2.5 rounded-xl border border-red-800"></div>

				<div class="flex flex-wrap items-center justify-between gap-2 pt-2 border-t border-slate-800/80">
					<button
						type="button"
						id="btn-quitar-cert"
						class="hidden px-3 py-2.5 rounded-xl bg-red-950/60 hover:bg-red-900/60 text-red-300 border border-red-800/70 text-xs font-semibold transition"
					>
						Quitar certificación
					</button>

					<div class="flex items-center gap-2 ml-auto">
						<button
							type="button"
							id="btn-cancelar-modal"
							class="px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-slate-300 transition"
						>
							Cancelar
						</button>
						<button
							type="submit"
							id="btn-confirmar-cert"
							class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-xs font-bold text-white transition shadow-lg shadow-emerald-600/20"
						>
							✓ Confirmar Certificación
						</button>
					</div>
				</div>
			</form>
		</div>
	</div>

	<script>
		import { jsPDF } from 'jspdf';
		import autoTable from 'jspdf-autotable';

		let datosInscritos = [];
		let claveSesion = '';

		const authForm = document.getElementById('authForm');
		const authError = document.getElementById('auth-error');
		const btnAcceder = document.getElementById('btn-acceder');

		// Elementos del Modal
		const modalCertificar = document.getElementById('modal-certificar');
		const formCertificar = document.getElementById('formCertificar');
		const modalError = document.getElementById('modal-error');
		const btnConfirmarCert = document.getElementById('btn-confirmar-cert');
		const btnQuitarCert = document.getElementById('btn-quitar-cert');
		const modalAvisoDatos = document.getElementById('modal-aviso-datos');

		const inputCertMonto = document.getElementById('cert-monto');

		// Máscara automática miles y decimales (1.250,00)
		inputCertMonto.addEventListener('input', () => {
			const soloDigitos = inputCertMonto.value.replace(/\D/g, '');
			if (!soloDigitos) {
				inputCertMonto.value = '';
				return;
			}
			const numero = parseInt(soloDigitos, 10) / 100;
			inputCertMonto.value = formatearNumeroVE(numero);
		});

		// Formatea siempre con punto para miles y coma para decimales: 1250 -> "1.250,00"
		function formatearNumeroVE(valor) {
			const num = Number(valor);
			if (isNaN(num)) return '';
			const partes = num.toFixed(2).split('.');
			partes[0] = partes[0].replace(/\B(?=(\d{3})+(?!\d))/g, '.');
			return partes.join(',');
		}

		// Convierte "1.250,00" (o "1,250.00" o "1250") -> 1250.00 sin importar el navegador
		function limpiarMontoParaAPI(valorFormateado) {
			if (valorFormateado === null || valorFormateado === undefined) return '';
			const str = String(valorFormateado).trim();
			if (!str) return '';

			// Si tiene ambos (ej: "1.250,00" o "1,250.00"), el último símbolo es el decimal
			if (str.includes(',') && str.includes('.')) {
				const ultimaComa = str.lastIndexOf(',');
				const ultimoPunto = str.lastIndexOf('.');
				const limpio = ultimaComa > ultimoPunto
					? str.replace(/\./g, '').replace(',', '.')
					: str.replace(/,/g, '');
				const num = parseFloat(limpio);
				return isNaN(num) ? '' : num;
			}

			// Si solo tiene coma (ej: "1250,50")
			if (str.includes(',')) {
				const num = parseFloat(str.replace(',', '.'));
				return isNaN(num) ? '' : num;
			}

			// Si solo tiene puntos o solo dígitos
			const num = parseFloat(str);
			return isNaN(num) ? '' : num;
		}
		
		authForm.addEventListener('submit', async (e) => {
			e.preventDefault();
			authError.classList.add('hidden');
			btnAcceder.disabled = true;
			btnAcceder.textContent = 'Verificando...';

			const clave = document.getElementById('clave_maestra').value;

			try {
				const res = await fetch('/api/exportar', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ clave })
				});

				const data = await res.json();
				if (!res.ok) throw new Error(data.error || 'Error de autenticación');

				claveSesion = clave;
				datosInscritos = data.inscritos;
				renderizarPanel(datosInscritos);

				document.getElementById('login-box').classList.add('hidden');
				document.getElementById('panel-box').classList.remove('hidden');
			} catch (err) {
				authError.textContent = err.message;
				authError.classList.remove('hidden');
			} finally {
				btnAcceder.disabled = false;
				btnAcceder.textContent = 'Ingresar';
			}
		});

		function formatearMontoBs(valor) {
			if (valor === null || valor === undefined || valor === '') return '';
			return `Bs. ${formatearNumeroVE(valor)}`;
		}

		// Extrae el detalle de transacción si tiene datos registrados
		function obtenerDetalleTransaccion(item) {
			const partes = [];

			if (item.estado_pago === 'pagado_movil') {
				partes.push('Pago Móvil');
			} else if (item.estado_pago === 'pagado_efectivo') {
				partes.push('Efectivo');
			}

			if (item.monto_bs) {
				partes.push(formatearMontoBs(item.monto_bs));
			}

			if (item.banco_emisor) {
				partes.push(item.banco_emisor);
			}

			if (item.referencia) {
				partes.push(`Ref: ${item.referencia}`);
			}

			if (item.fecha_pago) {
				partes.push(`(${item.fecha_pago})`);
			}

			if (item.estado_pago === 'pagado_efectivo' && item.responsable_cobro) {
				partes.push(`Recibió: ${item.responsable_cobro}`);
			}

			return partes.length > 0 ? partes.join(' | ') : null;
		}

		function formatearEstatusYPago(item) {
			const esCertificado = Boolean(item.certificado);
			const detalleTx = obtenerDetalleTransaccion(item);

			if (esCertificado) {
				return detalleTx
					? `CERTIFICADO (${detalleTx})`
					: `CERTIFICADO (Sin datos de transacción registrados)`;
			}

			if (detalleTx) {
				return `Por verificar (${detalleTx})`;
			}

			return 'PENDIENTE DE PAGO';
		}

		function abrirModalCertificar(item) {
			modalError.classList.add('hidden');
			document.getElementById('cert-id').value = item.id;
			document.getElementById('modal-participante-info').textContent = `${item.nombre_apellido} (${item.codigo}) — ${item.iglesia}`;

			const tieneMonto = item.monto_bs !== null && item.monto_bs !== undefined && String(item.monto_bs) !== '';
			const tieneRef = item.referencia !== null && item.referencia !== undefined && String(item.referencia).trim() !== '';

			// Prellenar inputs formateando miles y decimales en el monto
			document.getElementById('cert-monto').value = tieneMonto ? formatearNumeroVE(item.monto_bs) : '';
			document.getElementById('cert-referencia').value = item.referencia ?? '';

			const esCertificado = Boolean(item.certificado);

			// Encabezado y botones según si es nueva certificación o edición
			document.getElementById('modal-titulo').textContent = esCertificado
				? 'Editar Datos / Certificación'
				: 'Certificar Participante';
			btnConfirmarCert.textContent = esCertificado
				? 'Guardar Cambios'
				: '✓ Confirmar Certificación';
			btnQuitarCert.classList.toggle('hidden', !esCertificado);

			// Banner informativo con los datos previos del participante
			if (tieneMonto || tieneRef) {
				const resumenPrevio = [
					tieneMonto ? `Monto: ${formatearMontoBs(item.monto_bs)}` : null,
					tieneRef ? `Ref: ${item.referencia}` : null
				].filter(Boolean).join(' • ');

				modalAvisoDatos.className = 'p-3 rounded-xl text-xs border bg-sky-950/60 border-sky-700/60 text-sky-200';
				modalAvisoDatos.innerHTML = `ℹ️ <strong>Datos registrados previamente:</strong> ${resumenPrevio}.<br><span class="text-sky-300/80 text-[11px]">Puedes confirmarlos tal como están o modificarlos debajo.</span>`;
			} else {
				modalAvisoDatos.className = 'p-3 rounded-xl text-xs border bg-slate-950/80 border-slate-800 text-slate-400';
				modalAvisoDatos.innerHTML = `Este participante no registró monto ni referencia. Puedes certificarlo directamente o agregar los datos si los tienes.`;
			}

			modalCertificar.classList.remove('hidden');
		}

		document.getElementById('btn-cancelar-modal').addEventListener('click', () => {
			modalCertificar.classList.add('hidden');
		});

		// Quitar certificación desde el modal
		btnQuitarCert.addEventListener('click', async () => {
			const id = document.getElementById('cert-id').value;
			const item = datosInscritos.find(x => x.id === id);
			if (!item) return;

			if (!confirm(`¿Seguro que deseas quitar la certificación de ${item.nombre_apellido}?`)) return;

			btnQuitarCert.disabled = true;
			btnQuitarCert.textContent = 'Quitando...';
			modalError.classList.add('hidden');

			try {
				const res = await fetch('/api/certificar', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						clave: claveSesion,
						id,
						certificado: false
					})
				});

				const result = await res.json();
				if (!res.ok) throw new Error(result.error || 'Error al quitar certificación');

				const index = datosInscritos.findIndex(x => x.id === id);
				if (index !== -1 && result.inscrito) {
					datosInscritos[index] = result.inscrito;
				}
				renderizarPanel(datosInscritos);
				modalCertificar.classList.add('hidden');
			} catch (err) {
				modalError.textContent = err.message;
				modalError.classList.remove('hidden');
			} finally {
				btnQuitarCert.disabled = false;
				btnQuitarCert.textContent = 'Quitar certificación';
			}
		});

		// Confirmar certificación o guardar edición de monto/referencia
		formCertificar.addEventListener('submit', async (e) => {
			e.preventDefault();
			modalError.classList.add('hidden');
			btnConfirmarCert.disabled = true;
			const textoOriginal = btnConfirmarCert.textContent;
			btnConfirmarCert.textContent = 'Guardando...';

			const id = document.getElementById('cert-id').value;
			const montoCrudo = document.getElementById('cert-monto').value.trim();
			const monto_bs = montoCrudo
				? parseFloat(montoCrudo.replace(/\./g, '').replace(',', '.'))
				: '';
			const referencia = document.getElementById('cert-referencia').value;

			try {
				const res = await fetch('/api/certificar', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						clave: claveSesion,
						id,
						certificado: true,
						monto_bs,
						referencia
					})
				});

				const result = await res.json();
				if (!res.ok) throw new Error(result.error || 'Error al certificar');

				const index = datosInscritos.findIndex(x => x.id === id);
				if (index !== -1 && result.inscrito) {
					datosInscritos[index] = result.inscrito;
				}
				renderizarPanel(datosInscritos);
				modalCertificar.classList.add('hidden');
			} catch (err) {
				modalError.textContent = err.message;
				modalError.classList.remove('hidden');
			} finally {
				btnConfirmarCert.disabled = false;
				btnConfirmarCert.textContent = textoOriginal;
			}
		});

		function renderizarPanel(lista) {
			const total = lista.length;
			const certificados = lista.filter(i => Boolean(i.certificado)).length;
			const plan20 = lista.filter(i => i.plan_inversion === '20_usd').length;
			const plan12 = lista.filter(i => i.plan_inversion === '12_usd').length;
			const pendientes = lista.filter(i => i.estado_pago === 'pendiente' && !i.certificado).length;
			const solventes = total - pendientes;

			document.getElementById('stat-total').textContent = total;
			document.getElementById('stat-certificados').textContent = certificados;
			document.getElementById('stat-plan20').textContent = plan20;
			document.getElementById('stat-plan12').textContent = plan12;
			document.getElementById('stat-pagados').textContent = solventes;
			document.getElementById('stat-pendientes').textContent = pendientes;

			const tbody = document.getElementById('tabla-inscritos');
			if (lista.length === 0) {
				tbody.innerHTML = `<tr><td colspan="9" class="py-8 text-center text-slate-400">Aún no hay participantes registrados.</td></tr>`;
				return;
			}

			tbody.innerHTML = lista.map((item, idx) => {
				const esCertificado = Boolean(item.certificado);
				const detalleTx = obtenerDetalleTransaccion(item);
				const planTxt = item.plan_inversion === '20_usd' ? '$20 (Almuerzo)' : '$12 (Básico)';

				let celdaPagoHtml = '';
				if (esCertificado) {
					celdaPagoHtml = `
						<span class="inline-flex items-center gap-1 font-bold text-emerald-400">
							✓ Certificado / Pagado
						</span>
						<span class="block text-[11px] ${detalleTx ? 'text-slate-300' : 'text-slate-500 italic'}">
							${detalleTx || 'Sin datos de transacción registrados'}
						</span>
					`;
				} else if (detalleTx) {
					celdaPagoHtml = `
						<span class="inline-flex items-center gap-1 font-semibold text-sky-300">
							Pago reportado (Sin certificar)
						</span>
						<span class="block text-[11px] text-slate-400">${detalleTx}</span>
					`;
				} else {
					celdaPagoHtml = `<span class="font-bold text-amber-400">PENDIENTE DE PAGO</span>`;
				}

				const btnClase = esCertificado
					? 'bg-emerald-500/20 text-emerald-300 border-emerald-500/40 hover:bg-emerald-500/30'
					: 'bg-slate-800/90 text-slate-300 border-slate-700 hover:border-emerald-500 hover:text-white';

				const btnTexto = esCertificado ? '✓ Certificado' : 'Certificar';

				return `
					<tr class="hover:bg-slate-800/40 transition">
						<td class="py-3 px-4 font-mono text-slate-400">${idx + 1}</td>
						<td class="py-3 px-4 font-mono font-bold text-sky-400">${item.codigo}</td>
						<td class="py-3 px-4 font-semibold text-white">
							${item.nombre_apellido}
							<span class="block text-[11px] font-normal text-slate-400">${item.correo}</span>
						</td>
						<td class="py-3 px-4">${item.iglesia}</td>
						<td class="py-3 px-4">${item.sirve_area && item.nombre_area ? item.nombre_area : '—'}</td>
						<td class="py-3 px-4 font-mono">${item.telefono}</td>
						<td class="py-3 px-4 font-semibold ${item.plan_inversion === '20_usd' ? 'text-emerald-400' : 'text-sky-300'}">${planTxt}</td>
						<td class="py-3 px-4">${celdaPagoHtml}</td>
						<td class="py-3 px-4 text-center">
							<button
								type="button"
								data-id="${item.id}"
								class="btn-accion-certificar px-3 py-1.5 rounded-lg border text-[11px] font-bold transition whitespace-nowrap ${btnClase}"
							>
								${btnTexto}
							</button>
						</td>
					</tr>
				`;
			}).join('');

			document.querySelectorAll('.btn-accion-certificar').forEach(btn => {
				btn.addEventListener('click', () => {
					const id = btn.getAttribute('data-id');
					const item = datosInscritos.find(x => x.id === id);
					if (item) abrirModalCertificar(item);
				});
			});
		}

		// Generación del PDF Oficial
		document.getElementById('btn-descargar-pdf').addEventListener('click', () => {
			const doc = new jsPDF({ orientation: 'landscape', unit: 'mm', format: 'letter' });

			doc.setFillColor(15, 23, 42);
			doc.rect(0, 0, 280, 28, 'F');

			doc.setTextColor(255, 255, 255);
			doc.setFontSize(14);
			doc.setFont('helvetica', 'bold');
			doc.text('ADIEL • DISTRITO 7 — REPORTE DE INSCRITOS', 14, 12);

			doc.setFontSize(9.5);
			doc.setFont('helvetica', 'normal');
			doc.setTextColor(186, 230, 253);
			doc.text('Taller PEP: Predicación Expositiva de la Palabra (Libro de Jonás) | 20 y 21 de Noviembre — I.E.L. El Trigal, Valencia', 14, 19);

			const fechaEmision = new Date().toLocaleString('es-VE');
			doc.setFontSize(8);
			doc.setTextColor(203, 213, 225);
			doc.text(`Emitido: ${fechaEmision}`, 265, 12, { align: 'right' });

			const total = datosInscritos.length;
			const certificados = datosInscritos.filter(i => Boolean(i.certificado)).length;
			const plan20 = datosInscritos.filter(i => i.plan_inversion === '20_usd').length;
			const plan12 = datosInscritos.filter(i => i.plan_inversion === '12_usd').length;
			const pendientes = datosInscritos.filter(i => i.estado_pago === 'pendiente' && !i.certificado).length;
			const solventes = total - pendientes;

			doc.setTextColor(30, 41, 59);
			doc.setFontSize(8.5);
			doc.setFont('helvetica', 'bold');
			
			const totalBs = datosInscritos.reduce((acc, item) => acc + (Number(item.monto_bs) || 0), 0);
			const totalBsTxt = formatearMontoBs(totalBs) || 'Bs. 0,00';

			doc.text(
				`Resumen:  Total: ${total}  |  Certificados: ${certificados}  |  Plan $20: ${plan20}  |  Plan $12: ${plan12}  |  Solventes: ${solventes}  |  Pendientes: ${pendientes}  |  Total Reportado: ${totalBsTxt}`,
				14,
				36
			);

			const filas = datosInscritos.map((item, index) => [
				index + 1,
				item.codigo,
				item.nombre_apellido,
				item.iglesia,
				item.sirve_area && item.nombre_area ? item.nombre_area : 'No',
				item.telefono,
				item.plan_inversion === '20_usd' ? '$20 (Almuerzo)' : '$12 (Básico)',
				formatearEstatusYPago(item)
			]);

			autoTable(doc, {
				startY: 41,
				head: [['#', 'Código', 'Nombre y Apellido', 'Iglesia', 'Área Servicio', 'Teléfono', 'Plan', 'Estatus y Detalle de Pago']],
				body: filas,
				theme: 'grid',
				styles: {
					fontSize: 8,
					cellPadding: 2.5,
					textColor: [15, 23, 42],
					lineColor: [203, 213, 225],
					lineWidth: 0.2
				},
				headStyles: {
					fillColor: [3, 105, 161],
					textColor: [255, 255, 255],
					fontStyle: 'bold',
					halign: 'left'
				},
				alternateRowStyles: {
					fillColor: [248, 250, 252]
				},
				columnStyles: {
					0: { cellWidth: 9, halign: 'center' },
					1: { cellWidth: 23, fontStyle: 'bold' },
					2: { cellWidth: 40 },
					3: { cellWidth: 42 },
					4: { cellWidth: 26 },
					5: { cellWidth: 25 },
					6: { cellWidth: 24 },
					7: { cellWidth: 'auto' }
				},
				didParseCell: function (data) {
					if (data.section === 'body' && data.column.index === 7) {
						const texto = String(data.cell.raw || '');
						if (texto === 'PENDIENTE DE PAGO') {
							data.cell.styles.textColor = [180, 83, 9];
							data.cell.styles.fontStyle = 'bold';
						} else if (texto.startsWith('CERTIFICADO')) {
							data.cell.styles.textColor = [4, 120, 87];
							data.cell.styles.fontStyle = 'bold';
						} else {
							data.cell.styles.textColor = [3, 105, 161];
						}
					}
				}
			});

			const fechaArchivo = new Date().toISOString().split('T')[0];
			doc.save(`Inscritos_PEP_Jonas_ADIEL_D7_${fechaArchivo}.pdf`);
		});

		document.getElementById('btn-cerrar-sesion').addEventListener('click', () => {
			datosInscritos = [];
			claveSesion = '';
			authForm.reset();
			document.getElementById('panel-box').classList.add('hidden');
			document.getElementById('login-box').classList.remove('hidden');
		});
	</script>
</Layout>