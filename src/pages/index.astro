				bloquePago.classList.add('hidden');

				detallePagoWhatsapp =
					`💵 *Estado:* Pagado en Efectivo / Otro\n` +
					(montoFormateado ? `💰 *Monto pagado:* ${montoFormateado}\n` : '') +
					`👤 *Recibido por:* ${datos.responsable_cobro || 'No especificado'}`;
				notaFinalWhatsapp = `✅ _Registro enviado para confirmación de cupo._`;
			} else {
				estadoTag.textContent = 'Pendiente de Pago';
				estadoTag.className = 'text-xs font-bold px-2.5 py-1 rounded-full bg-amber-500/20 text-amber-400 border border-amber-500/30';
				bloquePago.classList.remove('hidden');
				document.getElementById('res-monto-pagar').textContent = esPlan20 ? '$20 USD (al cambio)' : '$12 USD (al cambio)';

				detallePagoWhatsapp = `⏳ *Estado:* Pendiente por cancelar`;
				notaFinalWhatsapp = `📌 _En breve realizaré el aporte y enviaré el capture por este medio._`;
			}

			const servicioTexto = datos.sirve_area && datos.nombre_area
				? `Sí (${datos.nombre_area})`
				: 'No';

			const mensajeWhatsapp =
				`✝️ *REGISTRO OFICIAL — TALLER PEP*\n` +
				`_Predicación Expositiva de la Palabra: Libro de Jonás_\n` +
				`*ADIEL • Distrito 7*\n` +
				`━━━━━━━━━━━━━━━━━━━━\n` +
				`🎟️ *Código:* ${datos.codigo}\n` +
				`👤 *Participante:* ${datos.nombre_apellido}\n` +
				`⛪ *Iglesia:* ${datos.iglesia}\n` +
				`🙌 *Área de servicio:* ${servicioTexto}\n` +
				`📱 *Teléfono:* ${datos.telefono}\n` +
				`✉️ *Correo:* ${datos.correo}\n` +
				`━━━━━━━━━━━━━━━━━━━━\n` +
				`📋 *Plan:* ${planTexto}\n` +
				`${detallePagoWhatsapp}\n` +
				`━━━━━━━━━━━━━━━━━━━━\n` +
				`${notaFinalWhatsapp}`;

			document.getElementById('btn-enviar-resumen-whatsapp').href =
				`https://wa.me/584122027166?text=${encodeURIComponent(mensajeWhatsapp)}`;
		}

		// Botón para copiar la tarea previa
		const btnCopiarTarea = document.getElementById('btn-copiar-tarea');
		const textoBtnCopiar = document.getElementById('texto-btn-copiar');

		btnCopiarTarea.addEventListener('click', async () => {
			const textoTarea = `📖 PREPARACIÓN GENERAL — TALLER PEP: LIBRO DE JONÁS (ADIEL D7)

