---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

export const prerender = false;

let listaIglesias = [
  'Iglesia Evangélica Libre El Trigal',
  'Iglesia Evangélica Libre Central',
  'Iglesia Evangélica Libre Naguanagua',
  'Iglesia Evangélica Libre San Diego'
];

try {
  if (import.meta.env.SUPABASE_URL) {
    const { data } = await supabase.from('iglesias').select('nombre').order('nombre', { ascending: true });
    if (data && data.length > 0) {
      listaIglesias = data.map(i => i.nombre);
    }
  }
} catch (e) {
  console.log("Supabase en espera de configuración");
}
---

<Layout title="PEP: Libro de Jonás | ADIEL Distrito 7">
	<style is:global>
		input[type="date"] {
			color-scheme: dark;
			cursor: pointer;
		}
		@media print {
			@page {
				margin: 1.2cm;
				size: auto;
			}
			body {
				background: #ffffff !important;
				color: #0f172a !important;
				-webkit-print-color-adjust: exact;
				print-color-adjust: exact;
			}
			.no-print {
				display: none !important;
			}
			main {
				padding: 0 !important;
				margin: 0 !important;
				max-width: 100% !important;
			}
			#inscripcion {
				max-width: 100% !important;
				margin: 0 !important;
			}
			.print-card {
				background: #ffffff !important;
				border: none !important;
				box-shadow: none !important;
				padding: 0 !important;
				backdrop-filter: none !important;
			}
			.print-box {
				background: #f8fafc !important;
				border: 1px solid #cbd5e1 !important;
				color: #0f172a !important;
				break-inside: avoid;
			}
			.print-text-dark {
				color: #0f172a !important;
			}
			.print-text-muted {
				color: #475569 !important;
			}
		}
	</style>

	<!-- Luces ambientales de fondo -->
	<div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none no-print">
		<div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[750px] h-[520px] bg-gradient-to-tr from-sky-600/25 via-indigo-600/25 to-slate-800/20 blur-[130px] rounded-full"></div>
		<div class="absolute top-[700px] -left-36 w-[450px] h-[450px] bg-blue-600/15 blur-[120px] rounded-full"></div>
	</div>

	<!-- Barra de Navegación -->
	<header class="sticky top-0 z-40 backdrop-blur-md bg-slate-950/80 border-b border-slate-800/80 no-print">
		<div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
			<div class="flex items-center space-x-3">
				<span class="px-2.5 py-1 rounded-lg bg-sky-600 font-black text-xs tracking-wider text-white shadow-lg shadow-sky-500/30">ADIEL • D7</span>
				<span class="font-bold text-base sm:text-lg tracking-tight text-slate-100">PEP — Libro de Jonás</span>
			</div>
			<a href="#inscripcion" class="text-xs sm:text-sm font-semibold bg-sky-600/20 text-sky-300 hover:bg-sky-600 hover:text-white px-4 py-2 rounded-xl transition border border-sky-500/30">
				Inscribirme
			</a>
		</div>
	</header>

	<main class="max-w-6xl mx-auto px-4 py-12 md:py-20 space-y-20">
		<!-- PORTADA / HERO -->
		<section class="text-center space-y-8 max-w-4xl mx-auto no-print">
			<div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-semibold bg-sky-500/10 border border-sky-500/30 text-sky-300">
				<span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
				ADIEL • Distrito 7 — Taller de Capacitación Bíblica
			</div>

			<div class="space-y-3">
				<p class="text-sm sm:text-base font-bold uppercase tracking-[0.2em] text-sky-400">
					Predicación Expositiva de la Palabra (PEP)
				</p>
				<h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white leading-[1.12]">
					Estudio del <span class="bg-gradient-to-r from-sky-400 via-indigo-300 to-white bg-clip-text text-transparent italic font-serif">Libro de Jonás</span>
				</h1>
			</div>

			<p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
				Dos jornadas intensivas de exposición bíblica, herramientas hermenéuticas y edificación ministerial para pastores, líderes y servidores de nuestras congregaciones.
			</p>

			<!-- Tarjetas de Información del Flyer -->
			<div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-4 text-left">
				<div class="p-5 rounded-2xl bg-slate-900/70 border border-slate-800/90 backdrop-blur-sm">
					<div class="text-xs text-sky-400 uppercase font-bold tracking-wider">Fecha y Horario</div>
					<div class="text-base font-bold text-white mt-1.5">Viernes 20 y Sábado 21 de Noviembre</div>
					<div class="text-xs text-slate-400 mt-0.5">De 08:00 AM a 05:00 PM</div>
				</div>

				<div class="p-5 rounded-2xl bg-slate-900/70 border border-slate-800/90 backdrop-blur-sm">
					<div class="text-xs text-sky-400 uppercase font-bold tracking-wider">Sede del Evento</div>
					<div class="text-base font-bold text-white mt-1.5">I.E.L. El Trigal</div>
					<div class="text-xs text-slate-400 mt-0.5">Valencia</div>
				</div>

				<div class="p-5 rounded-2xl bg-slate-900/70 border border-slate-800/90 backdrop-blur-sm">
					<div class="text-xs text-sky-400 uppercase font-bold tracking-wider">Opciones de Inversión</div>
					<div class="mt-1.5 space-y-1">
						<div class="text-sm font-bold text-white flex justify-between">
							<span>$12 USD</span>
							<span class="text-xs font-normal text-slate-400">Material y café</span>
						</div>
						<div class="text-sm font-bold text-emerald-400 flex justify-between">
							<span>$20 USD</span>
							<span class="text-xs font-normal text-slate-300">Material + Almuerzo (2 días)</span>
						</div>
					</div>
				</div>
			</div>

			<div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-4">
				<a href="#inscripcion" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl text-base font-bold text-white bg-gradient-to-r from-sky-600 to-indigo-600 hover:from-sky-500 hover:to-indigo-500 transition shadow-xl shadow-sky-600/25 transform active:scale-[0.98]">
					Registrar mi Participación
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
				</a>
				<a href="https://wa.me/584124241541?text=Hola%2C%20quisiera%20m%C3%A1s%20informaci%C3%B3n%20sobre%20el%20taller%20PEP%20Libro%20de%20Jon%C3%A1s" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl text-sm font-semibold text-emerald-300 bg-emerald-950/40 hover:bg-emerald-900/50 border border-emerald-700/60 transition">
					<span>💬 Mayor Información Aquí</span>
				</a>
			</div>
		</section>

		<!-- SECCIÓN DEL FORMULARIO Y TICKET -->
		<section id="inscripcion" class="max-w-2xl mx-auto">
			<div class="bg-slate-900/85 border border-slate-800/90 rounded-3xl p-6 sm:p-10 shadow-2xl backdrop-blur-xl relative overflow-hidden print-card">
				
				<!-- Vista del Formulario -->
				<div id="form-container" class="no-print">
					<div class="mb-8 border-b border-slate-800 pb-5">
						<span class="text-xs font-bold uppercase tracking-wider text-sky-400">ADIEL • Distrito 7</span>
						<h2 class="text-2xl font-bold text-white mt-1">Planilla de Inscripción PEP</h2>
						<p class="text-sm text-slate-400 mt-1">Completa tus datos para reservar tu material y cupo</p>
					</div>

					<form id="registroForm" class="space-y-6">
						<!-- Datos Personales -->
						<div class="space-y-4">
							<div>
								<label class="block text-xs font-semibold uppercase text-slate-300 mb-1.5" for="nombre_apellido">Nombre y Apellido *</label>
								<input required type="text" id="nombre_apellido" name="nombre_apellido" placeholder="Ej. Pedro Perez" class="w-full px-4 py-3 rounded-xl bg-slate-950/70 border border-slate-800 text-white placeholder-slate-500 focus:outline-none focus:border-sky-500 transition" />
							</div>

							<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
								<div>
									<label class="block text-xs font-semibold uppercase text-slate-300 mb-1.5" for="telefono">Teléfono / WhatsApp *</label>
									<input required type="tel" id="telefono" name="telefono" placeholder="Ej. 0412-1234567" class="w-full px-4 py-3 rounded-xl bg-slate-950/70 border border-slate-800 text-white placeholder-slate-500 focus:outline-none focus:border-sky-500 transition" />
								</div>
								<div>
									<label class="block text-xs font-semibold uppercase text-slate-300 mb-1.5" for="correo">Correo Electrónico *</label>
									<input required type="email" id="correo" name="correo" placeholder="correo@ejemplo.com" class="w-full px-4 py-3 rounded-xl bg-slate-950/70 border border-slate-800 text-white placeholder-slate-500 focus:outline-none focus:border-sky-500 transition" />
								</div>
							</div>
						</div>

						<!-- ¿Sirve en un área? -->
						<div class="p-4 rounded-2xl bg-slate-950/50 border border-slate-800/80 space-y-3">
							<span class="block text-sm font-semibold text-white">¿Actualmente sirves en algún área de tu iglesia?</span>
							<div class="flex items-center gap-6">
								<label class="inline-flex items-center gap-2 cursor-pointer">
									<input type="radio" name="sirve_area_radio" value="no" checked class="text-sky-600 focus:ring-0 w-4 h-4" />
									<span class="text-sm text-slate-300">No</span>
								</label>
								<label class="inline-flex items-center gap-2 cursor-pointer">
									<input type="radio" name="sirve_area_radio" value="si" class="text-sky-600 focus:ring-0 w-4 h-4" />
									<span class="text-sm text-slate-300">Sí</span>
								</label>
							</div>

							<div id="campo-area" class="hidden pt-2">
								<label class="block text-xs font-medium text-sky-300 mb-1">¿En cuál área o ministerio sirves?</label>
								<input type="text" id="nombre_area" placeholder="Ej. Predicación, Enseñanza, Jóvenes, Alabanza, Diaconado..." class="w-full px-4 py-2.5 rounded-xl bg-slate-900 border border-sky-500/40 text-white placeholder-slate-500 focus:outline-none focus:border-sky-400" />
							</div>
						</div>

						<!-- Iglesia (Select auto-alimentado) -->
						<div class="space-y-2">
							<label class="block text-xs font-semibold uppercase text-slate-300" for="select-iglesia">Iglesia de procedencia *</label>
							<select id="select-iglesia" required class="w-full px-4 py-3 rounded-xl bg-slate-950/70 border border-slate-800 text-white focus:outline-none focus:border-sky-500 transition">
								<option value="" disabled selected>Selecciona tu iglesia</option>
								{listaIglesias.map((iglesia) => (
									<option value={iglesia}>{iglesia}</option>
								))}
								<option value="__NUEVA__" class="font-bold text-sky-400 bg-slate-900">➕ Agregar otra iglesia no listada...</option>
							</select>

							<div id="nueva-iglesia-box" class="hidden p-3 rounded-xl bg-sky-950/30 border border-sky-800/60 space-y-2">
								<p class="text-xs text-sky-300">Escribe el nombre de tu iglesia para añadirla a la lista:</p>
								<div class="flex gap-2">
									<input type="text" id="input-nueva-iglesia" placeholder="Nombre completo de la iglesia" class="flex-1 px-3 py-2 text-sm rounded-lg bg-slate-900 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:border-sky-500" />
									<button type="button" id="btn-anadir-iglesia" class="px-4 py-2 text-xs font-bold rounded-lg bg-sky-600 hover:bg-sky-500 text-white transition">Añadir</button>
								</div>
							</div>
						</div>

						<!-- Selección del Plan de Inversión ($12 vs $20) -->
						<div class="space-y-3">
							<label class="block text-xs font-semibold uppercase text-slate-300">Selecciona tu Plan de Inversión *</label>
							<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
								<label class="cursor-pointer border border-slate-800 rounded-2xl p-4 flex flex-col justify-between hover:border-slate-700 has-[:checked]:border-sky-500 has-[:checked]:bg-sky-950/25 transition">
									<div class="flex items-center justify-between mb-1">
										<span class="text-lg font-extrabold text-white">$12 USD</span>
										<input type="radio" name="plan_inversion" value="12_usd" class="text-sky-600 focus:ring-0 w-4 h-4" />
									</div>
									<span class="text-xs font-semibold text-sky-300">Plan Básico</span>
									<span class="text-xs text-slate-400 mt-1">Incluye material del taller y café / refrigerio.</span>
								</label>

								<label class="cursor-pointer border border-slate-800 rounded-2xl p-4 flex flex-col justify-between hover:border-slate-700 has-[:checked]:border-emerald-500 has-[:checked]:bg-emerald-950/20 transition">
									<div class="flex items-center justify-between mb-1">
										<span class="text-lg font-extrabold text-emerald-400">$20 USD</span>
										<input type="radio" name="plan_inversion" value="20_usd" checked class="text-emerald-600 focus:ring-0 w-4 h-4" />
									</div>
									<span class="text-xs font-semibold text-emerald-300">Plan Completo</span>
									<span class="text-xs text-slate-400 mt-1">Incluye material + almuerzo de ambos días (viernes y sábado).</span>
								</label>
							</div>
						</div>

						<!-- Estado de Pago -->
						<div class="space-y-3">
							<label class="block text-xs font-semibold uppercase text-slate-300">Forma / Estado de Pago *</label>
							<div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
								<label class="cursor-pointer border border-slate-800 rounded-xl p-3 flex flex-col items-center text-center hover:border-slate-700 has-[:checked]:border-sky-500 has-[:checked]:bg-sky-950/20 transition">
									<input type="radio" name="estado_pago" value="pagado_movil" checked class="text-sky-600 focus:ring-0 mb-2" />
									<span class="text-xs font-bold text-white">Pago Móvil / Transf.</span>
								</label>
								<label class="cursor-pointer border border-slate-800 rounded-xl p-3 flex flex-col items-center text-center hover:border-slate-700 has-[:checked]:border-sky-500 has-[:checked]:bg-sky-950/20 transition">
									<input type="radio" name="estado_pago" value="pagado_efectivo" class="text-sky-600 focus:ring-0 mb-2" />
									<span class="text-xs font-bold text-white">Efectivo / Otro</span>
								</label>
								<label class="cursor-pointer border border-slate-800 rounded-xl p-3 flex flex-col items-center text-center hover:border-slate-700 has-[:checked]:border-amber-500 has-[:checked]:bg-amber-950/20 transition">
									<input type="radio" name="estado_pago" value="pendiente" class="text-amber-500 focus:ring-0 mb-2" />
									<span class="text-xs font-bold text-amber-400">Aún no he pagado</span>
								</label>
							</div>

							<!-- Opciones Pago Móvil (con datos oficiales visibles para pagar al momento) -->
							<div id="pago-movil-campos" class="space-y-3 pt-2">
								<div class="p-3.5 rounded-xl bg-sky-950/35 border border-sky-500/30 space-y-2">
									<div class="flex items-center justify-between">
										<span class="text-[11px] font-bold uppercase tracking-wider text-sky-300">💳 Datos Oficiales para Pago Móvil</span>
										<span class="text-[10px] text-slate-400">Paga ahora y registra tu ref.</span>
									</div>
									<div class="grid grid-cols-1 sm:grid-cols-3 gap-2 text-xs font-mono bg-slate-950/80 p-2.5 rounded-lg border border-slate-800">
										<div class="flex sm:flex-col justify-between">
											<span class="text-slate-400 text-[10px]">Banco:</span>
											<strong class="text-white">Mercantil (0105)</strong>
										</div>
										<div class="flex sm:flex-col justify-between items-center sm:items-start">
											<span class="text-slate-400 text-[10px]">Cédula:</span>
											<button type="button" data-copy="10168435" class="copy-chip text-sky-300 hover:text-white font-bold flex items-center gap-1" title="Copiar cédula">
												V-10.168.435 <span class="text-[10px]">📋</span>
											</button>
										</div>
										<div class="flex sm:flex-col justify-between items-center sm:items-start">
											<span class="text-slate-400 text-[10px]">Teléfono:</span>
											<button type="button" data-copy="04267426739" class="copy-chip text-sky-300 hover:text-white font-bold flex items-center gap-1" title="Copiar teléfono">
												0426-7426739 <span class="text-[10px]">📋</span>
											</button>
										</div>
									</div>
								</div>

								<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
									<div>
										<label class="block text-[11px] font-semibold text-slate-400 mb-1">Monto Pagado (Bs.) *</label>
										<input type="number" step="0.01" min="0" id="monto_bs_movil" placeholder="Ej. 1250.00" class="w-full px-3 py-2 text-sm rounded-lg bg-slate-950 border border-slate-800 text-white" />
									</div>
									<div>
										<label class="block text-[11px] font-semibold text-slate-400 mb-1">Banco Emisor</label>
										<input type="text" id="banco_emisor" placeholder="Ej. Mercantil, Banesco" class="w-full px-3 py-2 text-sm rounded-lg bg-slate-950 border border-slate-800 text-white" />
									</div>
									<div>
										<label class="block text-[11px] font-semibold text-slate-400 mb-1">Número de Referencia</label>
										<input type="text" id="referencia" placeholder="Últimos 6 dígitos" class="w-full px-3 py-2 text-sm rounded-lg bg-slate-950 border border-slate-800 text-white" />
									</div>
									<div>
										<label class="block text-[11px] font-semibold text-slate-400 mb-1" for="fecha_pago">Fecha de Pago</label>
										<input
											type="date"
											id="fecha_pago"
											onclick="this.showPicker && this.showPicker()"
											class="w-full px-3 py-2 text-sm rounded-lg bg-slate-950 border border-slate-800 text-white focus:outline-none focus:border-sky-500 transition cursor-pointer"
										/>
									</div>
								</div>
							</div>

							<!-- Opciones Efectivo -->
							<div id="pago-efectivo-campos" class="hidden space-y-3 pt-2">
								<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
									<div>
										<label class="block text-[11px] font-semibold text-slate-400 mb-1">Monto Pagado</label>
										<input type="number" step="0.01" min="0" id="monto_bs_efectivo" placeholder="" class="w-full px-3 py-2 text-sm rounded-lg bg-slate-950 border border-slate-800 text-white" />
									</div>
									<div>
										<label class="block text-[11px] font-semibold text-slate-400 mb-1">Responsable que recibió *</label>
										<input type="text" id="responsable_cobro" placeholder="Nombre del encargado" class="w-full px-3 py-2 text-sm rounded-lg bg-slate-950 border border-slate-800 text-white" />
									</div>
								</div>
							</div>

							<!-- Mensaje para Pendiente -->
							<div id="pago-pendiente-aviso" class="hidden p-3 rounded-xl bg-amber-500/10 border border-amber-500/30 text-xs text-amber-300">
								ℹ️ Puedes completar tu registro ahora. Al finalizar verás los datos oficiales de <strong>Banco Mercantil</strong> y el botón directo a WhatsApp para reportar tu aporte.
							</div>
						</div>

						<div id="form-error" class="hidden text-xs text-red-400 bg-red-950/50 p-3 rounded-xl border border-red-800"></div>

						<button type="submit" id="submit-btn" class="w-full py-4 rounded-xl font-bold text-white bg-gradient-to-r from-sky-600 via-indigo-600 to-blue-600 hover:from-sky-500 hover:to-indigo-500 transition shadow-lg shadow-sky-600/25 flex items-center justify-center gap-2">
							<span id="btn-text">Confirmar Inscripción</span>
							<span id="btn-spinner" class="hidden animate-spin">⚪</span>
						</button>
					</form>
				</div>

				<!-- Vista del Ticket / Resumen posterior al envío -->
				<div id="resumen-container" class="hidden space-y-6">
					<div class="text-center space-y-1.5">
						<div class="w-12 h-12 bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 rounded-full flex items-center justify-center mx-auto text-xl font-bold no-print">✓</div>
						<span class="text-xs font-bold uppercase tracking-wider text-sky-400 print-text-dark">ADIEL • Distrito 7</span>
						<h2 class="text-2xl font-extrabold text-white print-text-dark">Comprobante de Inscripción</h2>
						<p class="text-sm text-slate-300 print-text-muted">Taller PEP: Predicación Expositiva de la Palabra — Libro de Jonás</p>
						<p class="text-xs text-slate-400 print-text-muted">Viernes 20 y Sábado 21 de Noviembre (8:00 AM a 5:00 PM) • Iglesia Evangélica Libre El Trigal, Valencia</p>
					</div>

					<!-- Tarjeta del Ticket -->
					<div class="p-5 sm:p-6 rounded-2xl bg-slate-950 border border-slate-800 space-y-4 print-box">
						<div class="flex justify-between items-center border-b border-slate-800 pb-3">
							<span class="text-xs uppercase font-semibold text-slate-400 print-text-muted">Código de Inscripción</span>
							<span id="res-codigo" class="text-base font-mono font-bold text-sky-400 tracking-wider print-text-dark">PEP-000000</span>
						</div>

						<div class="grid grid-cols-2 gap-3 text-sm">
							<div>
