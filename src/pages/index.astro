					`🔢 *Referencia:* ${datos.referencia || 'No especificada'}\n` +
					`📅 *Fecha de pago:* ${datos.fecha_pago || 'No especificada'}`;
				notaFinalWhatsapp = `📎 _Adjunto mi comprobante de pago para validación._`;

			} else if (datos.estado_pago === 'pagado_efectivo') {
				estadoTag.textContent = 'Pagado (Efectivo)';
